{
  "name": "vue2-dlg-lib",
  "version": "1.0.0",
  "description": "A Vue.js 2 UI library for modal dialogs, toasts, and popup menus",
  "main": "dist/vue2-dlg-lib.js",
  "module": "dist/vue2-dlg-lib.esm.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "lint": "eslint --ext .js,.vue src/",
    "sbom": "cyclonedx-npm --omit=dev --output-format=JSON --output-file=reports/bom.json",
    "trivy": "docker run -it --rm -v trivy-cache:/root/.cache/trivy -v .:/app aquasec/trivy:0.70.0@sha256:be1190afcb28352bfddc4ddeb71470835d16462af68d310f9f4bca710961a41e fs -d /app",
    "snyk-test": "docker run --rm -it --env-file .env -v .:/app snyk/snyk:alpine 'snyk test' | tee reports/snyk.log"
  },
  "debris": {
    "sbom": "docker run --rm -v .:/app cyclonedx/cyclonedx-node -o /app/reports/sbom.xml /app"
  },
  "keywords": [
    "vue",
    "vue2",
    "dialog",
    "modal",
    "toast",
    "popup",
    "menu"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^2.6.0"
  },
  "devDependencies": {
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "mini-css-extract-plugin": "^2.8.0",
    "terser-webpack-plugin": "^5.3.10",
    "vue": "^2.7.16",
    "vue-loader": "^15.11.1",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  }
}
