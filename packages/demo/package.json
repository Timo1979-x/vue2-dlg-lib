{
  "name": "vue2-dlg-lib-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "lint": "eslint --ext .js,.vue src/",
    "sbom": "cyclonedx-npm --omit=dev --output-format=JSON --output-file=reports/bom.json",
    "trivy": "docker run -it --rm -v trivy-cache:/root/.cache/trivy -v .:/app aquasec/trivy:0.70.0@sha256:be1190afcb28352bfddc4ddeb71470835d16462af68d310f9f4bca710961a41e fs -d /app",
    "snyk-test": "docker run --rm -it --env-file .env -v .:/app snyk/snyk:alpine 'snyk test' | tee reports/snyk.log"
  },
  "dependencies": {
    "vue": "^2.7.16",
    "vue2-dlg-lib": "*"
  },
  "devDependencies": {
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^9.1.7",
    "mini-css-extract-plugin": "^2.8.0",
    "vue-loader": "^15.11.1",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
